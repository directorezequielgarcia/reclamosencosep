# Portal de Reclamos ENCOSEP — plantilla de variables de entorno
# Copiar a .env y completar con valores reales.

# Base de datos PostgreSQL
# Local dev: usar un Postgres local o el mismo Neon de producción
# Producción: lo provee Vercel/Neon automáticamente
DATABASE_URL="postgresql://usuario:pass@host:5432/encosep_reclamos"

# NextAuth — generar con: npx auth secret
AUTH_SECRET="REEMPLAZAR_CON_SECRETO_LARGO"
AUTH_URL="http://localhost:3000"

# WhatsApp Business Cloud API (bandeja de reclamos por WhatsApp)
# Ver docs/09_whatsapp.md para el paso a paso de alta en Meta Business.
WHATSAPP_TOKEN="REEMPLAZAR_TOKEN_PERMANENTE_DEL_SYSTEM_USER"
WHATSAPP_PHONE_NUMBER_ID="REEMPLAZAR_PHONE_NUMBER_ID"
WHATSAPP_APP_SECRET="REEMPLAZAR_APP_SECRET_DE_META_FOR_DEVELOPERS"
# String propio (inventado acá, no lo da Meta) que se pega en la config del
# webhook en Meta for Developers para validar el handshake inicial.
WHATSAPP_VERIFY_TOKEN="REEMPLAZAR_TOKEN_ARBITRARIO_PROPIO"
