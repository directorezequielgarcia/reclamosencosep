# Portal de Reclamos ENCOSEP — plantilla de variables de entorno
# Copiar a .env y completar con valores reales.

# Base de datos
# DEV (SQLite): "file:./dev.db"
# PROD (Postgres): "postgresql://usuario:pass@host:5432/encosep_reclamos"
DATABASE_URL="file:./dev.db"

# NextAuth — generar con: npx auth secret
AUTH_SECRET="REEMPLAZAR_CON_SECRETO_LARGO"
AUTH_URL="http://localhost:3000"
