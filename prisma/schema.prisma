// Portal de Reclamos ENCOSEP — modelo de datos MVP
// SQLite en dev, Postgres en prod (ambos compatibles con Prisma).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ─────────────────────────────────────────────
// Usuarios y roles
// ─────────────────────────────────────────────

enum Rol {
  CIUDADANO
  GESTOR_ENTE
  OPERADOR_PRESTADORA
  SUPER_ADMIN
  AUDITOR
  // ─ Roles del equipo del ENCOSEP (Ord. 13.189/17) ─
  DIRECTOR             // Directorio del Ente (Serdeiro, García, López): ven TODO y exportan informes oficiales
  COOPERATIVA_DOCS     // Adriana — administra documentación de prestadoras + certificaciones
  EXPEDIENTES          // Yanina — gestión de expedientes
  INSPECCIONES         // Julieta — inspecciones de campo
  AUDIENCIAS_MEDIOS    // Marcos — audiencias públicas y comunicación / clipping de medios
  // ─ Perfiles institucionales (consulta / aplicación de sanciones) ─
  PEM                  // Poder Ejecutivo Municipal (Secretario de Gobierno)
  CONCEJO_DELIBERANTE  // Presidencia y concejales
  AUTORIDAD_APLICACION // Aplica las sanciones (UGEM / Subsec. Redes / Subsec. Transporte)
}

model Usuario {
  id            String   @id @default(cuid())
  dni           String   @unique
  nombre        String
  apellido      String
  email         String?  @unique
  telefono      String?
  passwordHash  String
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  rol           Rol      @default(CIUDADANO)
  prestadoraId  String?
  prestadora    Prestadora? @relation(fields: [prestadoraId], references: [id])
  reclamos        Reclamo[]            @relation("ReclamoCiudadano")
  asignados       Reclamo[]            @relation("ReclamoAsignado")
  eventos         ReclamoEvento[]
  expedientesAbiertos Expediente[]     @relation("ExpIniciador")
  actos           ActoAdministrativo[] @relation("ActoAutor")
  documentosSubidos Documento[]        @relation("DocSubeUsuario")
  documentosRevisados Documento[]      @relation("DocRevisor")
  boletines       Boletin[]
  audienciasPublicas AudienciaPublica[]
  inspeccionesRealizadas Inspeccion[]  @relation("InspeccionInspector")
  informesMensualesEmitidos InformeMensual[]  @relation("InformeMensualEmisor")
  informesAnualesEmitidos   InformeAnual[]    @relation("InformeAnualEmisor")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  activo          Boolean  @default(true)
}

// ─────────────────────────────────────────────
// Servicios y prestadoras
// ─────────────────────────────────────────────

enum ServicioKind {
  RESIDUOS
  ENERGIA
  AGUA
  TRANSPORTE
}

model Servicio {
  id         String        @id @default(cuid())
  kind       ServicioKind  @unique
  nombre     String
  nombreCorto String
  prestadoras Prestadora[]
  reclamos   Reclamo[]
  inspecciones Inspeccion[]
}

model Prestadora {
  id          String     @id @default(cuid())
  razonSocial String
  cuit        String?    @unique
  servicios   Servicio[]
  operadores  Usuario[]
  reclamos    Reclamo[]
  expedientes Expediente[]
  documentos  Documento[]
  vencimientos Vencimiento[]
  inspecciones Inspeccion[]
  activa      Boolean    @default(true)
  createdAt   DateTime   @default(now())
}

// ─────────────────────────────────────────────
// Documentación de las prestadoras
// La prestadora sube documentación (balance anual, certificación mensual,
// etc.) y el Ente la revisa: aprueba, observa o rechaza.
// ─────────────────────────────────────────────

enum TipoDocumento {
  ANUAL              // balance anual, plan anual, memoria
  MENSUAL            // certificación mensual, informe operativo mensual
  CERTIFICACION      // certificación técnica puntual
  CONTRATO           // contrato, addenda, pliego firmado
  OTRO               // otros (notas, descargos formales no en expediente)
}

enum EstadoDocumento {
  PENDIENTE          // recibido, esperando revisión
  EN_REVISION        // un gestor lo está revisando
  ANALIZADO          // revisión técnica terminada, decisión pendiente
  APROBADO           // OK, queda en el archivo
  OBSERVADO          // hay objeciones, la prestadora debe corregir
  INCOMPLETO         // falta documentación complementaria — la prestadora debe ampliar
  RECHAZADO          // rechazado definitivamente
}

model Documento {
  id            String          @id @default(cuid())
  prestadoraId  String
  prestadora    Prestadora      @relation(fields: [prestadoraId], references: [id])

  tipo          TipoDocumento
  periodo       String          // "2026" para anual; "2026-05" para mensual
  titulo        String
  descripcion   String?

  // Archivo (un solo PDF/archivo por documento; permite re-uploads via
  // un Documento nuevo si el actual queda OBSERVADO)
  archivoUrl    String
  mimeType      String?
  bytes         Int?

  estado        EstadoDocumento @default(PENDIENTE)
  comentarioRevision String?

  subidoPorId   String
  subidoPor     Usuario         @relation("DocSubeUsuario", fields: [subidoPorId], references: [id])
  revisorId     String?
  revisor       Usuario?        @relation("DocRevisor", fields: [revisorId], references: [id])

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  revisadoEn    DateTime?

  @@index([prestadoraId, estado])
  @@index([tipo, periodo])
  @@index([estado])
}

// ─────────────────────────────────────────────
// Reclamos
// ─────────────────────────────────────────────

enum ReclamoEstado {
  RECIBIDO
  EN_REVISION
  DERIVADO
  EN_PROCESO
  RESUELTO
  CERRADO_SIN_SOLUCION
  RECHAZADO
}

enum TipoEvento {
  CREACION
  CAMBIO_ESTADO
  ASIGNACION
  COMENTARIO
  ADJUNTO
  NOTIFICACION
}

model Reclamo {
  id           String        @id @default(cuid())
  codigo       String        @unique           // visible al ciudadano: A-2418
  ciudadanoId  String
  ciudadano    Usuario       @relation("ReclamoCiudadano", fields: [ciudadanoId], references: [id])
  // Reclamo "de oficio" generado por el Ente desde una inspección de campo.
  // Cuando origenOficio = true, ciudadanoId apunta al inspector que lo creó,
  // pero se trata como denuncia institucional del propio ENCOSEP.
  origenOficio        Boolean      @default(false)
  inspeccionOrigenId  String?
  inspeccionOrigen    Inspeccion?  @relation("ReclamoOriginadoEnInspeccion", fields: [inspeccionOrigenId], references: [id])
  servicioId   String
  servicio     Servicio      @relation(fields: [servicioId], references: [id])
  prestadoraId String?
  prestadora   Prestadora?   @relation(fields: [prestadoraId], references: [id])
  asignadoAId  String?
  asignadoA    Usuario?      @relation("ReclamoAsignado", fields: [asignadoAId], references: [id])

  titulo       String
  descripcion  String
  // Multimodal: foto/voz/opciones se persisten en Adjunto[]
  // y en respuestas estructuradas (JSON) según el wizard del servicio.
  respuestas   String?       // JSON con respuestas estructuradas del wizard

  // Ubicación
  direccion    String
  barrio       String?
  lat          Float?
  lng          Float?

  estado       ReclamoEstado @default(RECIBIDO)
  slaHoras     Int           @default(72)
  slaDeadline  DateTime?

  expedienteId String?
  expediente   Expediente?   @relation(fields: [expedienteId], references: [id])

  recursoDirecto         Boolean  @default(false)
  recursoDirectoEn       DateTime?
  copiaExpedienteSolicitada Boolean @default(false)
  copiaExpedienteEn      DateTime?

  puntajeEnte            Int?     // 1-5 — encuesta de cierre de reclamo
  puntajePrestadora      Int?     // 1-5
  comentarioEncuesta     String?
  encuestaEn             DateTime?

  adjuntos     Adjunto[]
  eventos      ReclamoEvento[]
  inspecciones Inspeccion[]  @relation("InspeccionReclamos")

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  cerradoEn    DateTime?

  @@index([estado, servicioId])
  @@index([ciudadanoId])
  @@index([prestadoraId, estado])
  @@index([expedienteId])
}

// ─────────────────────────────────────────────
// Expedientes administrativos
// El Ente puede elevar uno o varios reclamos a un expediente formal
// contra una prestadora, con actos administrativos (intimaciones,
// resoluciones, descargos, notificaciones, etc.).
// ─────────────────────────────────────────────

enum ExpedienteEstado {
  ABIERTO
  EN_TRAMITE
  RESUELTO
  ARCHIVADO
}

enum TipoActo {
  CARATULACION
  ACTA_RECEPCION
  NOTIFICACION
  INTIMACION
  DESCARGO_PRESTADORA
  CONSTATACION
  AMPLIACION
  DISPOSICION
  RESOLUCION
  CIERRE
  NOTA
}

model Expediente {
  id           String           @id @default(cuid())
  numero       String           @unique          // ej: EXP-2026-001
  caratula     String                            // ej: "ENCOSEP c/ SCPL s/ servicio de agua"
  asunto       String
  tipoExpediente String         @default("Reclamo individual")
  intervinientes String?                          // texto: reclamante, prestadora, otros
  solicitadoPor  String?                          // origen: Autoridad de Aplicación, Concejo, otro
  prestadoraId String
  prestadora   Prestadora       @relation(fields: [prestadoraId], references: [id])
  estado       ExpedienteEstado @default(ABIERTO)
  iniciadorId  String                            // usuario del Ente que abrió
  iniciador    Usuario          @relation("ExpIniciador", fields: [iniciadorId], references: [id])
  reclamos     Reclamo[]
  actos        ActoAdministrativo[]
  inspecciones Inspeccion[]
  mensajes     MensajeExpediente[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  cerradoEn    DateTime?

  @@index([prestadoraId, estado])
  @@index([estado])
}

enum CanalMensaje {
  USUARIO    // chat con el vecino reclamante
  PRESTADORA // chat con la empresa prestadora
}

model MensajeExpediente {
  id           String       @id @default(cuid())
  expedienteId String
  expediente   Expediente   @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  canal        CanalMensaje
  autorId      String                            // quién lo escribió
  autorNombre  String                            // nombre desnormalizado para mostrar
  esEnte       Boolean                           // true = lo escribió el Ente
  cuerpo       String
  createdAt    DateTime     @default(now())

  @@index([expedienteId, canal, createdAt])
}

model ActoAdministrativo {
  id           String     @id @default(cuid())
  expedienteId String
  expediente   Expediente @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  tipo         TipoActo
  titulo       String
  cuerpo       String                             // texto del acto (puede ser extenso)
  autorId      String
  autor        Usuario    @relation("ActoAutor", fields: [autorId], references: [id])
  adjuntos     ActoAdjunto[]
  // Notificación por botón: hasta que no se notifica, el acto no se comunica.
  notificadoEn DateTime?
  notificadoA  String?                            // a quién se notificó (prestadora, AA, etc.)
  // Visibilidad para la prestadora. Se enciende al notificar:
  //  - "solo esta etapa": marca este acto.
  //  - "hasta acá": marca todos los actos hasta este.
  visiblePrestadora Boolean @default(false)
  createdAt    DateTime   @default(now())

  @@index([expedienteId, createdAt])
}

model ActoAdjunto {
  id        String             @id @default(cuid())
  actoId    String
  acto      ActoAdministrativo @relation(fields: [actoId], references: [id], onDelete: Cascade)
  tipo      AdjuntoTipo
  url       String                       // ruta local en dev, S3 en prod
  nombre    String?                      // nombre original del archivo
  mimeType  String?
  bytes     Int?
  createdAt DateTime           @default(now())

  @@index([actoId])
}

model ReclamoEvento {
  id         String       @id @default(cuid())
  reclamoId  String
  reclamo    Reclamo      @relation(fields: [reclamoId], references: [id], onDelete: Cascade)
  tipo       TipoEvento
  estadoNuevo ReclamoEstado?
  autorId    String?
  autor      Usuario?     @relation(fields: [autorId], references: [id])
  mensaje    String?
  // Comentario visible para el vecino (respuesta del Ente al reclamante) vs.
  // nota interna del equipo. Por defecto false = interno (no rompe lo existente).
  visibleVecino Boolean   @default(false)
  createdAt  DateTime     @default(now())

  @@index([reclamoId, createdAt])
}

enum AdjuntoTipo {
  FOTO
  VIDEO
  AUDIO
  DOCUMENTO
}

model Adjunto {
  id        String      @id @default(cuid())
  reclamoId String
  reclamo   Reclamo     @relation(fields: [reclamoId], references: [id], onDelete: Cascade)
  tipo      AdjuntoTipo
  url       String                       // ruta local en dev, S3 en prod
  mimeType  String?
  bytes     Int?
  createdAt DateTime    @default(now())
}

// ─────────────────────────────────────────────
// Boletines y comunicaciones del Ente
// El Ente publica boletines oficiales, comunicados y notas de prensa
// (también clippings de menciones en medios y redes).
// ─────────────────────────────────────────────

enum TipoBoletin {
  BOLETIN_OFICIAL
  COMUNICADO
  NOTA_PRENSA
  CLIPPING       // mención en medio externo / red social
}

model Boletin {
  id              String      @id @default(cuid())
  tipo            TipoBoletin
  numero          String?
  titulo          String
  resumen         String?
  cuerpo          String?     // texto largo opcional
  archivoUrl      String?     // PDF / imagen adjunta opcional
  enlaceExterno   String?     // link a medio externo (para CLIPPING)
  fuente          String?     // p.ej. "Diario Crónica", "Twitter / X"
  fechaPublicacion DateTime
  publicado       Boolean     @default(true)
  autorId         String
  autor           Usuario     @relation(fields: [autorId], references: [id])
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([tipo, fechaPublicacion])
  @@index([publicado, fechaPublicacion])
}

// ─────────────────────────────────────────────
// Audiencias Públicas
// El Ente convoca audiencias públicas. Los vecinos se inscriben online.
// ─────────────────────────────────────────────

enum ModalidadAudiencia {
  PRESENCIAL
  VIRTUAL
  HIBRIDA
}

enum EstadoAudiencia {
  PROGRAMADA
  ABIERTA_INSCRIPCION
  CERRADA_INSCRIPCION
  REALIZADA
  CANCELADA
}

model AudienciaPublica {
  id            String              @id @default(cuid())
  titulo        String
  descripcion   String
  fecha         DateTime
  lugar         String?
  enlaceVirtual String?
  modalidad     ModalidadAudiencia
  estado        EstadoAudiencia     @default(PROGRAMADA)
  capacidad     Int?

  // Expediente al que refiere la audiencia
  expedienteNumero String?
  expedienteTitulo String?
  expedienteUrl    String?  // PDF del expediente para "vista del expediente"

  // Convocatoria (texto completo + fecha de publicación + cierre de inscripción)
  convocatoriaTexto      String?
  convocatoriaPublicadaEn DateTime?
  inscripcionCierra      DateTime?

  // Orden del día (PDF)
  ordenDiaUrl  String?

  // Resultado / acta posterior
  actaTexto    String?
  actaUrl      String?
  realizadaEn  DateTime?

  // Material de la audiencia ya realizada
  videoUrl                       String?  // link al video grabado (YouTube, Vimeo, etc.)
  transcripcionTaquigraficaUrl   String?  // archivo de la transcripción
  transcripcionTaquigraficaTexto String?  // alternativa: texto pegable
  // Dictamen del ENCOSEP posterior a la audiencia
  dictamenTexto String?
  dictamenUrl   String?

  inscripciones InscripcionAudiencia[]
  autorId       String
  autor         Usuario             @relation(fields: [autorId], references: [id])
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([estado, fecha])
}

model InscripcionAudiencia {
  id          String           @id @default(cuid())
  audienciaId String
  audiencia   AudienciaPublica @relation(fields: [audienciaId], references: [id], onDelete: Cascade)
  nombre      String
  apellido    String
  dni         String
  email       String
  telefono    String?
  comentario  String?
  createdAt   DateTime         @default(now())

  @@unique([audienciaId, dni])
  @@index([audienciaId])
}

// ─────────────────────────────────────────────
// Vencimientos de documentación de prestadoras
// El Ente define qué documentos debe presentar cada prestadora y cuándo.
// El sistema marca como VENCIDO los pendientes que pasaron la fecha.
// ─────────────────────────────────────────────

enum EstadoVencimiento {
  PENDIENTE
  CUMPLIDO
  VENCIDO
  PRORROGADO
  EXCEPTUADO
}

model Vencimiento {
  id           String            @id @default(cuid())
  prestadoraId String
  prestadora   Prestadora        @relation(fields: [prestadoraId], references: [id])
  tipo         TipoDocumento
  periodo      String            // "2026" o "2026-05"
  titulo       String            // ej "Balance anual", "Certificación mensual"
  fechaLimite  DateTime
  estado       EstadoVencimiento @default(PENDIENTE)
  observacion  String?
  documentoId  String?           // se vincula cuando se cumple
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([prestadoraId, estado])
  @@index([estado, fechaLimite])
}

// ─────────────────────────────────────────────
// Encuesta general de satisfacción
// Cualquier vecino (anónimo o logueado) puede responder cómo evalúa cada
// servicio público bajo control del Ente. Alimenta los indicadores.
// ─────────────────────────────────────────────

model EncuestaServicios {
  id               String   @id @default(cuid())
  puntajeAgua      Int?     // 1-5
  puntajeEnergia   Int?
  puntajeResiduos  Int?
  puntajeTransporte Int?
  comentario       String?
  barrio           String?
  // Identificación opcional para evitar spam — no se muestra públicamente
  dniHash          String?  // hash del DNI si el vecino se identifica
  createdAt        DateTime @default(now())

  @@index([createdAt])
}

// ─────────────────────────────────────────────
// Inspecciones de campo
// Las realiza Julieta (rol INSPECCIONES) y los directores. Cada inspección
// puede tener audio dictado en campo, múltiples fotos y coordenadas GPS.
// Alimentan las secciones 2 y 3 del informe mensual oficial del Directorio.
// ─────────────────────────────────────────────

enum TipoInspeccion {
  OFICIO                  // inspección de oficio (rutina o seguimiento)
  DENUNCIA_VECINO         // disparada por una denuncia / reclamo de vecino
  SEGUIMIENTO_EXPEDIENTE  // verifica avance de un expediente abierto
  EVENTO_PUNTUAL          // contingencia (corte masivo, deslizamiento, etc.)
}

enum EstadoInspeccion {
  BORRADOR    // en captura, todavía no se considera oficial
  PUBLICADA   // visible y exportable
  ARCHIVADA   // queda en el archivo histórico, no aparece en bandeja activa
}

model Inspeccion {
  id            String           @id @default(cuid())
  codigo        String           @unique         // ej: INS-2026-001

  fecha         DateTime                         // fecha y hora del relevamiento
  inspectorId   String
  inspector     Usuario          @relation("InspeccionInspector", fields: [inspectorId], references: [id])

  servicioId    String
  servicio      Servicio         @relation(fields: [servicioId], references: [id])
  prestadoraId  String?
  prestadora    Prestadora?      @relation(fields: [prestadoraId], references: [id])

  tipo          TipoInspeccion   @default(OFICIO)
  estado        EstadoInspeccion @default(BORRADOR)

  titulo        String                           // resumen corto (1 línea)
  observaciones String                           // texto largo — lo que se escribe o transcribe

  // Ubicación
  direccion     String?
  barrio        String?
  lat           Float?
  lng           Float?

  // Audio dictado en campo (un único archivo principal por inspección)
  audioUrl          String?
  audioMimeType     String?
  audioBytes        Int?
  audioDuracionSeg  Int?
  transcripcionAudio String?                     // editable, puede venir de Web Speech API o cargado a mano

  // Vínculos opcionales con otros registros del sistema
  expedienteId  String?
  expediente    Expediente?      @relation(fields: [expedienteId], references: [id])
  reclamos      Reclamo[]        @relation("InspeccionReclamos")
  // Reclamos de oficio generados a partir de esta inspección.
  reclamosOriginados Reclamo[]   @relation("ReclamoOriginadoEnInspeccion")

  // Acta exportada
  actaUrl       String?                          // .docx generado y guardado en Blob
  actaGeneradaEn DateTime?

  fotos         InspeccionFoto[]

  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([servicioId, estado])
  @@index([inspectorId, fecha])
  @@index([estado, fecha])
  @@index([expedienteId])
}

model InspeccionFoto {
  id           String     @id @default(cuid())
  inspeccionId String
  inspeccion   Inspeccion @relation(fields: [inspeccionId], references: [id], onDelete: Cascade)
  url          String
  descripcion  String?
  mimeType     String?
  bytes        Int?
  // Coordenadas opcionales si la foto trae EXIF GPS
  lat          Float?
  lng          Float?
  orden        Int        @default(0)
  createdAt    DateTime   @default(now())

  @@index([inspeccionId, orden])
}

// ─────────────────────────────────────────────
// Informe Mensual del Estado de los Servicios Públicos (art. 5° inc. k
// Ordenanza N° 13.189/17). Un único registro por mes/año, con las 7
// secciones obligatorias y cifras agregadas como snapshot.
// Los `bloques` se guardan en JSON estructurado para permitir editor por
// sección (y por servicio donde aplica) sin migración por campo.
// ─────────────────────────────────────────────

enum EstadoInformeMensual {
  BORRADOR    // se está editando, no es oficial todavía
  PUBLICADO   // emitido por la Dirección, se considera el informe del mes
  ARCHIVADO   // versión anterior conservada por historial
}

// ─────────────────────────────────────────────
// Informe Anual de Gestión (art. 5° Ord. 13.189/17).
// Se eleva al Concejo Deliberante y al Poder Ejecutivo Municipal con
// deadline al 1° de octubre de cada año. Cubre el período definido por
// el Directorio (típicamente octubre del año previo a septiembre).
// ─────────────────────────────────────────────

enum EstadoInformeAnual {
  BORRADOR
  PUBLICADO
  ARCHIVADO
}

model InformeAnual {
  id            String              @id @default(cuid())
  periodoDesde  DateTime
  periodoHasta  DateTime
  titulo        String                                  // ej: "Informe de Gestión 2025-2026"

  estado        EstadoInformeAnual  @default(BORRADOR)

  // Bloques narrativos:
  //   { balance, logros, desafios, sugerencias, anexoMensuales }
  bloques       Json

  // Cifras congeladas al emitir (totales por servicio, serie temporal, etc.)
  metricas      Json

  emitidoPorId  String?
  emitidoPor    Usuario?            @relation("InformeAnualEmisor", fields: [emitidoPorId], references: [id])
  emitidoEn     DateTime?

  docxUrl       String?

  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([estado, periodoDesde])
}

model InformeMensual {
  id          String                @id @default(cuid())
  mes         Int                                          // 1-12
  anio        Int

  estado      EstadoInformeMensual  @default(BORRADOR)

  // Bloques narrativos de las 7 secciones del art. 5° inc. k.
  // Estructura esperada en bloques (JSON):
  //   {
  //     seccion1: { intro: "...", porServicio: { RESIDUOS: "...", ENERGIA: "...", ... } },
  //     seccion2: { porServicio: { ... } },
  //     seccion3: { porServicio: { ... } },
  //     seccion4: "texto plano",
  //     seccion5: "texto plano",
  //     seccion6: "texto plano",
  //     seccion7: "texto plano",
  //   }
  bloques     Json

  // Cifras congeladas al momento de emitir, para que la generación del
  // .docx sea reproducible aunque cambien los datos crudos despues.
  metricas    Json

  emitidoPorId String?
  emitidoPor   Usuario?             @relation("InformeMensualEmisor", fields: [emitidoPorId], references: [id])
  emitidoEn    DateTime?

  docxUrl     String?

  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@unique([anio, mes])
  @@index([estado, anio, mes])
}
